# PostgreSQL Database Connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextstopturkey?schema=public"

# JWT & Session Secrets (Short-Lived 15m Access + Rotating 7d Refresh HttpOnly Cookies)
JWT_SECRET=change-this-to-a-cryptographic-64-char-access-secret
JWT_REFRESH_SECRET=change-this-to-a-distinct-cryptographic-64-char-refresh-secret
EMAIL_TOKEN_SECRET=change-this-to-a-distinct-email-optin-token-secret

# Server & CORS / CSRF Origin Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3100

# Next.js Internal On-Demand ISR Revalidation Webhook
NEXT_INTERNAL_URL=http://127.0.0.1:3100
REVALIDATE_SECRET=change-this-revalidate-secret-in-production

# Stripe Hosted Checkout Configuration (optional in Demo Mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
