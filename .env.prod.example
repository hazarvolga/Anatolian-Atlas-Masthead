# Production Environment Variables
# Copy this file to .env.prod and fill in your production values

# Database Configuration
DB_NAME=tours_db_prod
DB_USER=tours_user
DB_PASSWORD=your-super-secure-password-here
DATABASE_URL=postgresql://tours_user:your-super-secure-password-here@postgres:5432/tours_db_prod

# JWT Configuration  
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars-here

# Server Configuration
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://yourdomain.com

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_your_live_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret

# Email Configuration
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your-production-email@yourdomain.com
SMTP_PASS=your-email-app-password

# Security
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Monitoring & Analytics (optional)
SENTRY_DSN=your-sentry-dsn
GOOGLE_ANALYTICS_ID=your-ga-id
