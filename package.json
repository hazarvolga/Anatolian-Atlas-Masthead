{
  "name": "anatolian-atlas-masthead",
  "version": "2.0.0",
  "private": true,
  "description": "NextStopTurkey (Anatolian Atlas Edition) — Editorial travel monograph & Next.js 16 App Router platform with Express.js + Prisma + PostgreSQL backend.",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix web-next run dev",
    "build": "npm --prefix web-next run build",
    "start": "npm --prefix web-next run start",
    "typecheck": "npm --prefix web-next run typecheck",
    "lint": "npm --prefix web-next run lint",
    "backend:dev": "npm --prefix backend run dev",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "docker:dev": "docker-compose up -d --build",
    "docker:stop": "docker-compose down",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker build -t tours-app ."
  },
  "dependencies": {
    "@prisma/client": "^6.12.0"
  },
  "devDependencies": {
    "prisma": "^6.12.0"
  }
}
