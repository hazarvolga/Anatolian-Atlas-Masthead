import { useEffect, useState } from "react";
import { useSearchParams } from "react-router-dom";
import axios from "axios";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { CheckCircle, ArrowLeft, Download } from "lucide-react";
import { useVerifyPayment } from "@/hooks/usePayments";
import Navbar from "@/components/Navbar";
import Footer from "@/components/Footer";

export default function BookingSuccess() {
  const [searchParams] = useSearchParams();
  const sessionId = searchParams.get('session_id');
  const bookingId = searchParams.get('booking_id');
  const verifyPayment = useVerifyPayment();
  const [bookingData, setBookingData] = useState<any>(null);
  const [isReservationOnly, setIsReservationOnly] = useState(false);
  
  useEffect(() => {
    console.log('🔍 BookingSuccess - URL parametreleri:', { sessionId, bookingId });
    
    if (sessionId) {
      console.log('💳 Ödeme oturumu bulundu, doğrulanıyor...');
      verifyPayment.mutate(sessionId, {
        onSuccess: (data) => {
          if (data.success) {
            setBookingData(data.booking);
          }
        }
      });
    } else if (bookingId && bookingId !== 'undefined') {
      console.log('📝 Rezervasyon ID bulundu, sadece rezervasyon modu aktif');
      setIsReservationOnly(true);
      // Rezervasyon detaylarını çek
      fetchReservationDetails(bookingId);
    }
  }, [sessionId, bookingId]);
  
  const fetchReservationDetails = async (id: string) => {
    try {
      console.log('🔍 Rezervasyon detayları getiriliyor:', id);
      
      // Backend'den rezervasyon detaylarını çek
      const API_BASE_URL = import.meta.env.VITE_API_BASE_URL || 'http://localhost:3001';
      const response = await axios.get(`${API_BASE_URL}/api/reservations/${id}`);
      const data = response.data;
      
      if (data) {
        console.log('✅ Rezervasyon detayları alındı:', data);
        setBookingData(data);
      } else {
        console.error('❌ Rezervasyon bulunamadı');
        // Fallback data
        setBookingData({
          id: id,
          guest_name: 'Rezervasyon Sahibi',
          guest_email: 'email@example.com',
          booking_date: new Date().toISOString(),
          adults: 1,
          children: 0,
          total_price: 0,
          status: 'confirmed'
        });
      }
    } catch (error: any) {
      console.error('❌ Rezervasyon detayları alınamadı:', error.response?.data || error.message);
      // Fallback data
      setBookingData({
        id: id,
        guest_name: 'Rezervasyon Sahibi',
        guest_email: 'email@example.com',
        booking_date: new Date().toISOString(),
        adults: 1,
        children: 0,
        total_price: 0,
        status: 'confirmed'
      });
    }
  };
  
  if (!sessionId && (!bookingId || bookingId === 'undefined')) {
    return (
      <div className="min-h-screen flex flex-col">
        <Navbar />
        <main className="flex-1 flex items-center justify-center pt-20">
          <Card className="w-full max-w-md">
            <CardHeader>
              <CardTitle className="text-center text-red-600">Invalid Session</CardTitle>
              <CardDescription className="text-center">
                No payment session found.
              </CardDescription>
            </CardHeader>
            <CardContent>
              <Button onClick={() => window.location.href = "/"} className="w-full">
                <ArrowLeft className="h-4 w-4 mr-2" />
                Go to Home
              </Button>
            </CardContent>
          </Card>
        </main>
        <Footer />
      </div>
    );
  }
  
  return (
    <div className="min-h-screen flex flex-col">
      <Navbar />
      
      <main className="flex-1 pt-20">
        <section className="section">
          <div className="container">
            <div className="max-w-2xl mx-auto">
              {verifyPayment.isPending ? (
                <Card>
                  <CardContent className="pt-6">
                    <div className="text-center">
                      <div className="animate-spin rounded-full h-32 w-32 border-b-2 border-primary mx-auto mb-4"></div>
                      <h3 className="text-lg font-semibold mb-2">Verifying Payment...</h3>
                      <p className="text-muted-foreground">
                        Please wait while we confirm your booking.
                      </p>
                    </div>
                  </CardContent>
                </Card>
              ) : verifyPayment.error ? (
                <Card>
                  <CardHeader>
                    <CardTitle className="text-center text-red-600">Payment Verification Failed</CardTitle>
                    <CardDescription className="text-center">
                      There was an issue verifying your payment. Please contact support.
                    </CardDescription>
                  </CardHeader>
                  <CardContent>
                    <div className="space-y-4">
                      <Button onClick={() => window.location.href = "/contact"} className="w-full">
                        Contact Support
                      </Button>
                      <Button onClick={() => window.location.href = "/"} variant="outline" className="w-full">
                        <ArrowLeft className="h-4 w-4 mr-2" />
                        Go to Home
                      </Button>
                    </div>
                  </CardContent>
                </Card>
              ) : bookingData ? (
                <Card>
                  <CardHeader className="text-center">
                    <div className="mx-auto w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
                      <CheckCircle className="h-8 w-8 text-green-600" />
                    </div>
                    <CardTitle className="text-green-600">
                      {isReservationOnly ? 'Rezervasyon Başarılı!' : 'Payment Successful!'}
                    </CardTitle>
                    <CardDescription>
                      {isReservationOnly 
                        ? 'Rezervasyonunuz başarıyla kaydedildi. Ekibimiz sizinle iletişime geçerek ödeme detaylarını görüşecek.'
                        : 'Your booking has been confirmed. We\'ve sent a confirmation email to your address.'
                      }
                    </CardDescription>
                  </CardHeader>
                  <CardContent>
                    <div className="space-y-4">
                      <div className="p-4 bg-muted rounded-lg">
                        <h3 className="font-semibold mb-2">
                          {isReservationOnly ? 'Rezervasyon Detayları' : 'Booking Details'}
                        </h3>
                        <div className="space-y-1 text-sm">
                          <p><strong>{isReservationOnly ? 'Rezervasyon ID:' : 'Booking ID:'}</strong> {bookingData.id}</p>
                          <p><strong>{isReservationOnly ? 'Misafir Adı:' : 'Guest Name:'}</strong> {bookingData.guest_name}</p>
                          <p><strong>Email:</strong> {bookingData.guest_email}</p>
                          <p><strong>{isReservationOnly ? 'Tarih:' : 'Date:'}</strong> {new Date(bookingData.booking_date).toLocaleDateString()}</p>
                          <p><strong>{isReservationOnly ? 'Misafirler:' : 'Guests:'}</strong> {bookingData.adults} {isReservationOnly ? 'yetişkin' : 'adults'}{bookingData.children > 0 && `, ${bookingData.children} ${isReservationOnly ? 'çocuk' : 'children'}`}</p>
                          {!isReservationOnly && (
                            <p><strong>Total Paid:</strong> ${Number(bookingData.total_price).toFixed(2)}</p>
                          )}
                          <p><strong>{isReservationOnly ? 'Durum:' : 'Status:'}</strong> 
                            <span className="text-green-600 font-medium">
                              {isReservationOnly ? 'Onaylandı (Ödeme Bekleniyor)' : 'Confirmed'}
                            </span>
                          </p>
                        </div>
                      </div>
                      
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <Button onClick={() => window.location.href = "/my-reservations"} className="w-full">
                          {isReservationOnly ? 'Rezervasyonlarımı Görüntüle' : 'View My Reservations'}
                        </Button>
                        <Button onClick={() => window.location.href = "/"} variant="outline" className="w-full">
                          <ArrowLeft className="h-4 w-4 mr-2" />
                          {isReservationOnly ? 'Anasayfaya Dön' : 'Back to Home'}
                        </Button>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              ) : (
                <Card>
                  <CardHeader>
                    <CardTitle className="text-center text-yellow-600">Rezervasyon Alındı</CardTitle>
                    <CardDescription className="text-center">
                      Ödeme yapılmadığı için bir ödeme oturumu oluşturulmadı.<br />
                      Rezervasyonunuz başarıyla kaydedildi. Detayları profilinizden veya rezervasyonlarım sayfasından görüntüleyebilirsiniz.
                    </CardDescription>
                  </CardHeader>
                  <CardContent>
                    <div className="space-y-4">
                      <Button onClick={() => window.location.href = "/my-reservations"} className="w-full">
                        Rezervasyonlarımı Görüntüle
                      </Button>
                      <Button onClick={() => window.location.href = "/"} variant="outline" className="w-full">
                        <ArrowLeft className="h-4 w-4 mr-2" />
                        Anasayfaya Dön
                      </Button>
                    </div>
                  </CardContent>
                </Card>
              )}
            </div>
          </div>
        </section>
      </main>
      
      <Footer />
    </div>
  );
}
