# NextStopTurkey (Next.js 16 App Router) Environment Configuration

# Operating mode:
# - "demo": Uses deterministic Türkiye sample data in src/lib/data/demo-content.ts (no backend/DB required)
# - "connected": Connects to the Express + Prisma + PostgreSQL backend
NEXT_PUBLIC_DATA_MODE=connected

# Base URL for browser-side API requests (used in "connected" mode)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Internal URL for Server Components / SSR / ISR requests to Express backend
# (e.g., http://127.0.0.1:3001 locally or http://backend:3001 in Docker/Coolify)
API_INTERNAL_URL=http://127.0.0.1:3001
