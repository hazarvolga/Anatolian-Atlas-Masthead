# NextStopTurkey (Next.js 16 App Router) Environment Configuration

# Operating mode:
# - "demo": Uses deterministic Türkiye sample data in src/lib/data/demo-content.ts (no backend/DB required)
# - "connected": Connects to the Express + Prisma + PostgreSQL backend
NEXT_PUBLIC_DATA_MODE=connected

# Base URL for the Express backend API (used in "connected" mode)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
