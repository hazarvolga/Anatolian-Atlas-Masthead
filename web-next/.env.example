# NextStopTurkey (Next.js 16 App Router) Environment Configuration

# Demo Fallback Mode:
# - "false" (default / production): Strictly fetches from Express backend; returns 503/ErrorState on upstream failure and NEVER displays fake demo tours.
# - "true": Enables deterministic Türkiye showcase data (DEMO_TOURS / DEMO_DESTINATIONS) when running without a backend.
NEXT_PUBLIC_DEMO_MODE=false

# Base URL for browser-side API requests
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Internal URL for Server Components / SSR / ISR requests to Express backend
API_INTERNAL_URL=http://127.0.0.1:3001

# Internal shared secret for Express -> Next.js /api/revalidate webhook
REVALIDATE_SECRET=nst-internal-revalidate-secret
