# NextStopTurkey (Next.js 16 App Router) Environment Configuration

# 1. Demo Fallback Mode:
# - "false" (default / production): Strictly fetches from Express backend; returns 503/ErrorState on upstream failure and NEVER displays fake demo tours.
# - "true": Enables deterministic Türkiye showcase data (DEMO_TOURS / DEMO_DESTINATIONS), client-side `?preset=` preview, and Design Studio.
NEXT_PUBLIC_DEMO_MODE=false

# 2. Commercial Placeholder Image Mode:
# - "false" (default): Uses local editorial photographs under /public/demo/*.jpg.
# - "true": Replaces all demo photographs with neutral architectural SVG plates (/public/placeholders/*.svg) for commercial distribution packages.
NEXT_PUBLIC_DEMO_PLACEHOLDER_MODE=false

# 3. Design System Studio (/design-system):
# - Set to "true" to enable the interactive token & section studio (always noindex).
ENABLE_DESIGN_STUDIO=false

# 4. Strict Per-Request CSP Nonce Mode:
# - "false" (default ISR mode): Preserves Static/ISR (○ Static) caching on /, /tours, and /destinations while emitting x-nonce and COOP headers.
# - "true": Enforces `script-src 'self' 'nonce-<per-request>' 'strict-dynamic'` on responses.
CSP_STRICT_NONCE=false

# 5. API Endpoints:
# Base URL for browser-side API requests (withCredentials: true for HttpOnly cookies)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Internal URL for Server Components / SSR / ISR requests to Express backend
API_INTERNAL_URL=http://127.0.0.1:3001

# Canonical public site URL (used for sitemap.xml, robots.txt, llms.txt, canonical & hreflang tags)
NEXT_PUBLIC_SITE_URL=https://nextstopturkey.com

# 6. Internal Webhook Secret:
# Shared secret for Express -> Next.js POST /api/revalidate (timing-safe verified)
REVALIDATE_SECRET=change-this-revalidate-secret-in-production
