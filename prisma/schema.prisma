generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// AUTH AND USER MODELS
model User {
  id             String        @id @default(uuid()) @db.Uuid
  email          String        @unique
  password_hash  String
  role           String        @default("user") // e.g., user, admin, guide
  first_name     String
  last_name      String
  phone          String?
  avatar_url     String?
  email_verified Boolean       @default(false)
  is_active      Boolean       @default(true)
  last_login_at  DateTime?
  metadata       Json          @default("{}")
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  guidedTours    Tour[]        @relation("TourGuide")
  createdTours   Tour[]        @relation("TourCreatedBy")
  reservations   Reservation[]
  reviews        Review[]
  userRoles      UserRole[]
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  permissions Json       @default("[]")
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  userRoles   UserRole[]
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  role_id    String   @db.Uuid
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
}

// CORE BUSINESS MODELS
model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  image_url   String?
  is_active   Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  tours       Tour[]
}

model Destination {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  slug              String   @unique
  country_id        String
  city_id           String?
  country           String?
  city              String?
  short_description String?
  description       String
  featured          Boolean  @default(false)
  is_active         Boolean  @default(true)
  coords            String?
  best_time         String?
  activities        Json     @default("[]")
  google_maps_url   String?
  gallery_images    Json     @default("[]")
  extra_info        Json     @default("{}")
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  tours             Tour[]
}

model Tour {
  id                  String        @id @default(uuid()) @db.Uuid
  title               String
  slug                String        @unique
  description         String
  short_description   String?
  category_id         String        @db.Uuid
  destination_id      String        @db.Uuid
  guide_id            String?       @db.Uuid
  created_by_id       String?       @db.Uuid
  status              String // e.g., draft, active, archived
  duration_hours      Int
  max_participants    Int
  min_participants    Int           @default(1)
  price_adult         Float
  price_child         Float?
  price_currency      String        @default("TRY")
  difficulty_level    Int?
  age_limit           Int?
  featured            Boolean       @default(false)
  includes            String[]
  excludes            String[]
  requirements        String[]
  cancellation_policy String?
  images              Json          @default("[]")
  metadata            Json          @default("{}")
  seo_title           String?
  seo_description     String?
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
  deleted_at          DateTime?
  category            Category      @relation(fields: [category_id], references: [id], onDelete: Restrict)
  destination         Destination   @relation(fields: [destination_id], references: [id], onDelete: Restrict)
  guide               User?         @relation("TourGuide", fields: [guide_id], references: [id], onDelete: SetNull)
  created_by          User?         @relation("TourCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  reservations        Reservation[]
  reviews             Review[]
  pricingData         TourPricing[]
  timeSlots           TimeSlot[]
  seasonalPricing     SeasonalPricing[]
  groupDiscounts      GroupDiscount[]
}

// PRICING AND AVAILABILITY MODELS
model TourPricing {
  id                 String   @id @default(uuid()) @db.Uuid
  tour_id            String   @db.Uuid
  customer_type      String   // adult, child, baby
  base_price         Float
  accommodation_type String?  // single, double, triple, shared, none
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  tour               Tour     @relation(fields: [tour_id], references: [id], onDelete: Cascade)

  @@index([tour_id])
}

model TimeSlot {
  id           String   @id @default(uuid()) @db.Uuid
  tour_id      String   @db.Uuid
  start_time   String
  end_time     String
  max_capacity Int
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  tour         Tour     @relation(fields: [tour_id], references: [id], onDelete: Cascade)

  @@index([tour_id])
}

model SeasonalPricing {
  id                String   @id @default(uuid()) @db.Uuid
  tour_id           String   @db.Uuid
  customer_type     String   // adult, child, baby
  start_date        DateTime
  end_date          DateTime
  price_adjustment  Float
  adjustment_type   String   // percentage, fixed
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  tour              Tour     @relation(fields: [tour_id], references: [id], onDelete: Cascade)

  @@index([tour_id])
}

model GroupDiscount {
  id                  String   @id @default(uuid()) @db.Uuid
  tour_id             String   @db.Uuid
  customer_type       String   // adult, child, baby
  min_group_size      Int
  max_group_size      Int?
  discount_type       String   // percentage, fixed
  discount_percentage Float?
  discount_amount     Float?
  discount_reason     String   // early_bird, family, student, group_size, seasonal, loyalty, last_minute
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  tour                Tour     @relation(fields: [tour_id], references: [id], onDelete: Cascade)

  @@index([tour_id])
}

model Reservation {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  tourId           String    @db.Uuid
  reservationDate  DateTime
  numAdults        Int
  numChildren      Int       @default(0)
  totalPrice       Float
  priceCurrency    String    @default("TRY")
  status           String // e.g., pending, confirmed, cancelled
  notes            String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour             Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  payment          Payment?
  email_logs       EmailLog[]

  @@index([userId])
  @@index([tourId])
}

model Payment {
  id                String      @id @default(uuid()) @db.Uuid
  reservationId     String      @unique @db.Uuid
  amount            Float
  currency          String      @default("TRY")
  status            String // e.g., succeeded, failed, pending
  payment_method    String // e.g., stripe, credit_card
  transaction_id    String?     @unique
  provider_response Json?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt
  reservation       Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model Review {
  id          String   @id @default(uuid()) @db.Uuid
  rating      Int
  comment     String?
  tourId      String   @db.Uuid
  userId      String   @db.Uuid
  is_verified Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  tour        Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([userId])
}

// SITE CONTENT & SETTINGS
model SiteSettings {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique
  value      Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// CMS PAGES
model Page {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  slug             String   @unique
  content          Json     @default("[]")
  meta_title       String?
  meta_description String?
  meta_keywords    String[] @default([])
  status           String   @default("draft")
  template_type    String   @default("default")
  is_homepage      Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([status])
}

// EMAIL AND LOGGING MODELS
model EmailTemplate {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @unique
  subject    String
  html       String
  text       String?
  type       String // e.g., booking_confirmation, password_reset
  is_active  Boolean    @default(true)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  logs       EmailLog[]
}

model EmailLog {
  id             String       @id @default(uuid()) @db.Uuid
  to             String
  template_id    String       @db.Uuid
  status         String // e.g., sent, failed
  error          String?
  sent_at        DateTime     @default(now())
  reservation_id String?      @db.Uuid
  template       EmailTemplate @relation(fields: [template_id], references: [id])
  reservation    Reservation? @relation(fields: [reservation_id], references: [id], onDelete: SetNull)
}

model EmailSubscription {
  id                     String   @id @default(uuid()) @db.Uuid
  email                  String
  subscription_type      String // transactional, marketing, newsletter, promotional
  is_subscribed          Boolean  @default(true)
  double_optin_confirmed Boolean  @default(false)
  consent_given_at       DateTime @default(now())
  last_updated           DateTime @updatedAt
  source                 String?
  ip_address             String?
  user_agent             String?

  @@unique([email, subscription_type])
  @@index([email])
}

